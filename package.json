{
	"name": "spritemagician",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"start": "cross-env BODY_SIZE_LIMIT=512M node build",
		"electron:dev": "npm run build && electron .",
		"electron:build": "npm run build && electron-builder",
		"prepare": "svelte-kit sync || echo \"\"",
		"check": "svelte-kit sync && svelte-check",
		"test": "node --test \"tests/*.test.js\""
	},
	"devDependencies": {
		"@sveltejs/adapter-node": "^5.2.12",
		"@sveltejs/kit": "^2.50.1",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/vite": "^4.1.18",
		"cross-env": "^10.0.0",
		"electron": "^38.2.1",
		"electron-builder": "^26.0.12",
		"svelte": "^5.48.2",
		"tailwindcss": "^4.1.18",
		"vite": "^7.3.1"
	},
	"dependencies": {
		"@google/genai": "^1.40.0",
		"sharp": "^0.35.5"
	},
	"description": "Local-first AI sprite and animation workstation",
	"license": "MIT",
	"main": "electron/main.cjs",
	"engines": {
		"node": ">=20.19"
	}
}
